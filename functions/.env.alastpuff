# Deploy-time parameters for the `alastpuff` project.
#
# SAFE TO COMMIT — configuration only. Secrets (GEMINI_API_KEY,
# REVENUECAT_WEBHOOK_TOKEN, REVENUECAT_SECRET_API_KEY) live in Google Secret
# Manager and must never appear here — Firebase uploads every key in a .env
# file as a plain environment variable, and a name bound both ways blocks the
# deploy ("Secret environment variable overlaps non secret environment
# variable", Sep 2 2026). Local emulator values go in .env.local, which Firebase reads
# for the emulator and never uploads.
#
# These mirror the defaults in src/config.ts. They exist as a file so a
# non-interactive deploy (CI) resolves every param the same way a local one
# does, and so a change to production config is a reviewable diff.

# The trusted tier comes from our own mirror of RevenueCat
# (`users/{uid}.entitlement`), written by `rcWebhook` and by the app's
# post-purchase `refreshEntitlement`. Free accounts get the free allowances
# below; subscribers get the premium ones.
#
# Flipped from `ungated` on Sep 3 2026 (docs/10 §18, `S1-15`). Until then
# `tierFor()` short-circuited to `premium` for every caller, so every server
# limit in this file was inert and there was nothing for anyone to buy.
#
# `ungated` still exists and still works — it is the switch to reach for if
# the mirror is ever wrong in the direction that matters, because everyone
# being over-served costs margin while everyone being under-served costs
# customers. Read the mirror before reaching for it: a `free` row on a paying
# account is a webhook problem, not a reason to open the gates.
ENTITLEMENT_MODE=mirror

# Sandbox purchases (Play license testers, TestFlight) flip the mirror too —
# they are all our own invited accounts, and the row records `environment`.
RC_ACCEPT_SANDBOX=true

# The RevenueCat project the v2 REST calls (customer snapshot, customer
# delete) are scoped to. Not a secret — it is in every dashboard URL.
RC_PROJECT_ID=proj2bbaaf3f

# Warm instances for the coach. 0 for now; 1-2 in production (~$15/mo) so a
# 2am craving does not wait on a cold start.
COACH_MIN_INSTANCES=0

# docs/04 §7. LIVE since the `mirror` flip — a free account really does get
# five coach messages a day, and `limit_reached` fires when it runs out.
FREE_DAILY_COACH_MESSAGES=5
PREMIUM_DAILY_COACH_MESSAGES=100

# docs/12 §4.1. Posting is an allowance, not a wall: a free account gets one
# ordinary post a day, a subscriber three. An SOS is refused for neither tier
# and spends its OWN allowance, so using your ordinary posts can never stop
# you asking for help — and a pinned-for-an-hour post still cannot be spammed
# without limit. LIVE since the `mirror` flip.
FREE_DAILY_POSTS=1
PREMIUM_DAILY_POSTS=3
DAILY_SOS_POSTS=3

# docs/05 §8 model routing. Params, not constants, so an EOL model is a config
# change rather than a redeploy of new code.
#
# Chosen from what the key can ACTUALLY call — `aiCoachChat` logs the live
# catalogue on a 404 (`coach.models_available`), which is how the original
# mistake was found: `gemini-3.1-flash` does not exist. Note the near miss —
# `gemini-3.1-flash-LITE` does, so only the premium id was wrong — and while
# ENTITLEMENT_MODE was `ungated` it routed EVERY user to premium, so every
# user got the broken one. Now that free accounts resolve to free, a mistake
# in one of these ids hits only the tier it names, which is quieter and
# therefore easier to miss.
#
# Four rules for anything set here:
#   1. No `-preview` ids. They get withdrawn.
#   2. Nothing on the 2.5 line — it retires 2026-10-16, the day after launch.
#   3. No `-latest` aliases, tempting as they are. docs/04 §9 gates the coach
#      on a full eval pass (`npm run eval:coach`), and an alias silently swaps
#      the model underneath a health-adjacent product. Pin, and re-run the
#      evals when you move it.
#   4. A non-lite id must be able to STOP THINKING (`thinkingLevel: MINIMAL`,
#      sent by ai/gemini.ts). gemini-3.7-flash cannot — its floor is LOW, a
#      variable 400-2000 thought tokens spent inside the output cap, which
#      truncated every premium reply mid-word for as long as it was deployed
#      and delays the first streamed token mid-craving. The automated evals
#      caught it; they will catch the next one too.
#
# Verified end-to-end against production: both ids answer, evals 19/19 each.
MODEL_FREE=gemini-3.5-flash-lite
MODEL_PREMIUM=gemini-3.6-flash
MODEL_MODERATION=gemini-3.5-flash-lite

# Cost kill-switch: "true" routes all coach traffic to the cheap model.
AI_COST_PANIC=false

# Set to false to stop suggesting follow-up chips on coach turns (docs/11 §3).
COACH_FOLLOWUPS=true
