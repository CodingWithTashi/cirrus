---
// Waitlist capture. Posts to the Pages Function at /api/subscribe.
//
// Progressive enhancement on purpose: a real <form> with a real action, so it
// still works with JavaScript off. The script upgrades it to an inline success
// state so nobody loses their place on the page.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { WAITLIST_COUNT } from '../consts';

interface Props {
  source?: string;
  id?: string;
  /** Hero shows the signup count; the closing band does not repeat it. */
  showCount?: boolean;
  label?: string;
  cta?: string;
}

const {
  source = 'hero',
  id = 'waitlist',
  showCount = false,
  label = 'Get early access',
  cta = 'Join the waitlist',
} = Astro.props;
---

<div class="waitlist" data-waitlist>
  <form class="waitlist__form" id={id} method="POST" action="/api/subscribe" data-source={source}>
    <p class="micro waitlist__label">{label}</p>

    <div class="waitlist-row">
      <label class="sr-only" for={`${id}-email`}>Your email address</label>
      <input
        id={`${id}-email`}
        class="waitlist-input"
        type="email"
        name="email"
        inputmode="email"
        enterkeyhint="send"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        placeholder="you@email.com"
        required
      />
      <input type="hidden" name="source" value={source} />
      {/* Honeypot. Hidden from people and assistive tech; bots fill it anyway. */}
      <div class="hp" aria-hidden="true">
        <label for={`${id}-website`}>Leave this empty</label>
        <input id={`${id}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <button class="btn btn-primary waitlist-btn" type="submit">{cta}</button>
    </div>

    <p class="waitlist-status" role="status" aria-live="polite">
      {showCount && <><strong>{WAITLIST_COUNT} already on the list</strong> · </>}No spam, ever.
    </p>
  </form>

  <div class="waitlist__done">
    <Image src={logo} width={44} height={44} layout="fixed" alt="" />
    <div>
      <strong>You're on the list.</strong>
      <span>Check your email to confirm. That's the step everyone forgets.</span>
    </div>
  </div>
</div>

<script>
  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-waitlist]'));

  // One list, one thank-you: subscribing in the hero flips the closing band too,
  // so scrolling down never shows a form you have already filled in.
  const celebrateAll = () => roots.forEach((r) => (r.dataset.done = 'true'));

  roots.forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form');
    const status = root.querySelector<HTMLElement>('.waitlist-status');
    const button = root.querySelector<HTMLButtonElement>('button[type=submit]');
    const input = root.querySelector<HTMLInputElement>('input[type=email]');
    if (!form || !status || !button || !input) return;

    const original = status.innerHTML;
    const fail = (msg: string) => {
      status.textContent = msg;
      status.dataset.tone = 'err';
      input.setAttribute('aria-invalid', 'true');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Joining…';
      status.dataset.tone = '';
      input.removeAttribute('aria-invalid');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            email: input.value,
            source: form.dataset.source ?? 'hero',
            website: root.querySelector<HTMLInputElement>('input[name=website]')?.value ?? '',
          }),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (res.ok && data.ok) {
          celebrateAll();
          return;
        }
        if (data.error === 'invalid_email') fail("That email doesn't look right.");
        else if (data.error === 'rate_limited') fail('Too many tries. Give it a minute.');
        else fail('Something went wrong on our end. Try again?');
      } catch {
        fail('Looks like you are offline. Try again when you have signal.');
      } finally {
        button.disabled = false;
        button.textContent = label ?? 'Join the waitlist';
        input.addEventListener(
          'input',
          () => {
            if (status.dataset.tone === 'err') {
              status.innerHTML = original;
              status.dataset.tone = '';
              input.removeAttribute('aria-invalid');
            }
          },
          { once: true },
        );
      }
    });
  });
</script>
