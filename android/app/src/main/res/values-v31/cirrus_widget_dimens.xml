<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ publishes the launcher's own widget corner radius. Matching it
     is what stops the card reading as a foreign rectangle on the home screen.
     A <dimen> may hold a resource reference, and <corners android:radius>
     resolves it. -->
<resources>
    <dimen name="cw_radius">@android:dimen/system_app_widget_background_radius</dimen>
</resources>
