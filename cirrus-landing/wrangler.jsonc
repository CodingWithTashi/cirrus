{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Cloudflare Pages project name. Must match the project in the dashboard,
	// otherwise `wrangler pages deploy` prompts interactively and fails in CI.
	"name": "cirrus-landing",
	"compatibility_date": "2026-08-30",
	// Static Astro output. `wrangler pages deploy` needs no directory argument.
	// There are no Pages Functions any more: the only one was the waitlist's
	// /api/subscribe, removed with the waitlist when both stores went live.
	"pages_build_output_dir": "./dist"

	// Production domain: cirrusquit.com (+ www, which 301s to the apex via a
	// zone Redirect Rule) is attached to this project in the dashboard under
	// Custom domains. It survives deploys; it is not managed from this file.
}
