---
// Every page renders through this layout, so <head> is correct in exactly one
// place: canonical URL, Open Graph, Twitter card, and the JSON-LD block.
import { Font, Image } from 'astro:assets';
import mark from '../assets/mark.png';
import { SITE_TITLE, SITE_OG_IMAGE, SOCIAL_PROFILES, PRIVACY_URL, TERMS_URL, DELETE_ACCOUNT_URL, APP_STORE_ID, APP_STORE_URL, PLAY_STORE_URL } from '../consts';
import { fmt, useT, type Locale } from '../i18n/index.ts';
import { AUTONYM, DEFAULT_LOCALE, HREFLANG, LIVE_LOCALES, OG_LOCALE } from '../i18n/locales.mjs';
import { link, localePath } from '../i18n/paths.ts';
import '../styles/global.css';

interface Props {
  /** The page's language. Everything language-shaped in <head>, the structured
      data and the header/footer follows it. English when omitted, so every
      page written before the site had a second language is still correct. */
  lang?: Locale;
  /** Every LIVE version of this page, keyed by locale, self included — the clean
      site-relative paths from alternatesFor() in i18n/paths.ts. Becomes the
      hreflang set. Omit on a page that exists in one language only. */
  alternates?: Partial<Record<Locale, string>>;
  title?: string;
  description?: string;
  /** Set on blog posts so the JSON-LD switches from WebSite to BlogPosting. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Per-page social image; falls back to the site default. */
  image?: string;
  /** Alt text for that image. A post's card describes that post, so the generic
      brand line is the wrong description of it — and it was the only one every
      page shipped until this prop existed. Falls back to the brand line for
      pages using the site-wide card, which the brand line genuinely describes. */
  imageAlt?: string;
  /** Keep drafts and utility pages out of the index. */
  noindex?: boolean;
  /** Emits FAQPage structured data. Must mirror FAQ markup actually on the page —
      schema describing invisible content is a manual-action risk. */
  faq?: readonly { q: string; a: string }[];
  /** Trail for the visible breadcrumb and its BreadcrumbList schema. Home is
      prepended automatically; omit on the home page, which has no parent. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Home advertises the app itself via SoftwareApplication. */
  softwareApp?: boolean;
  /** Post tags. Emitted as schema keywords + articleSection, not <meta keywords>. */
  keywords?: readonly string[];
  /** Measured, not claimed — see readingTime() in lib/posts.ts. */
  wordCount?: number;
  readingMinutes?: number;
  /** Named author. Falls back to the organisation when a post has no byline. */
  author?: { name: string; title?: string };
  /** The blog index passes its posts so the listing is machine-readable. */
  blogPosts?: readonly { title: string; url: string; date: Date }[];
}

const {
  lang = DEFAULT_LOCALE,
  alternates,
  title,
  description: descriptionProp,
  type = 'website',
  publishedAt,
  updatedAt,
  image = SITE_OG_IMAGE,
  imageAlt,
  noindex = false,
  faq,
  breadcrumbs,
  softwareApp = false,
  keywords,
  wordCount,
  readingMinutes,
  author,
  blogPosts,
} = Astro.props;

const t = useT(lang);
const description = descriptionProp ?? t.meta.description;

// Every page is "Page · Cirrus", home included: home's page name is
// `meta.title` ("Quit vaping app without going cold turkey"). Home used to be
// "Cirrus · <tagline>", which spent the first word of the result on a brand
// nobody searches yet and never said the thing was an app. Before that it fell
// back to SITE_DESCRIPTION and produced a 143-character title — Google
// truncates around 60.
const pageTitle = `${title ?? t.meta.title} · ${SITE_TITLE}`;

// Astro.site comes from `site` in astro.config.mjs.
//
// `build.format: 'file'` writes /blog/post.html, so Astro.url.pathname carries a
// .html suffix that the sitemap (which emits clean paths) does not. Strip the
// extension and any trailing slash, or Google sees two URLs for one page and
// the canonical points at the copy the sitemap never mentions.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/(.)\/$/, '$1');
const canonical = new URL(cleanPath, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;
const ogImageAlt = imageAlt ?? `${SITE_TITLE} — ${t.meta.tagline}`;

// This locale's home page. `/` in English and `/es` — never `/es/` — elsewhere:
// `build.format: 'file'` writes dist/es.html, the same shape /blog has.
const homePath = localePath(lang, '/');
const homeUrl = new URL(homePath, Astro.site).href;

// hreflang. One <link> per live version, self included, plus x-default → English.
// Nothing at all on a noindex page or a page with a single version: an hreflang
// set of one is noise, and one pointing at a page Google may not index is worse.
//
// The self-reference is checked, not trusted. hreflang only works when both ends
// agree, and a page whose own entry names a different URL than its canonical is
// the classic way a whole locale gets ignored — so that is a build error here
// rather than a Search Console warning three weeks later.
const hreflangs =
  !noindex && alternates && Object.keys(alternates).length > 1
    ? (Object.entries(alternates) as [Locale, string][])
    : [];
if (hreflangs.length && alternates?.[lang] !== cleanPath) {
  throw new Error(
    `BaseLayout: alternates.${lang} is "${alternates?.[lang]}" but this page is "${cleanPath}". ` +
      'The hreflang self-reference must equal the canonical path.',
  );
}

// Structured data, emitted as one @graph so the page ships a single script tag
// and the entities can cross-reference each other by @id.
// Google's Article guidance wants publisher.logo as a real ImageObject with
// dimensions, not a bare URL string — a plain string is silently ignored and
// the article loses its publisher attribution in rich results.
const org = {
  '@type': 'Organization',
  '@id': `${Astro.site?.href}#org`,
  name: SITE_TITLE,
  url: Astro.site?.href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo.png', Astro.site).href,
    width: 512,
    height: 512,
  },
  // Profiles Google uses to connect the site to a known entity. Empty until
  // real accounts exist — a sameAs pointing at nothing is worse than none.
  ...(SOCIAL_PROFILES.length ? { sameAs: SOCIAL_PROFILES } : {}),
};

const primary =
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        // Without mainEntityOfPage Google has to guess which URL the article
        // belongs to, which matters the moment a post is syndicated anywhere.
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
        datePublished: publishedAt?.toISOString(),
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        inLanguage: lang,
        publisher: { '@id': org['@id'] },
        // A named human when there is one; the organisation otherwise. Never
        // absent — an article with no author at all is the single most common
        // reason health content fails Google's quality bar.
        author: author
          ? { '@type': 'Person', name: author.name, ...(author.title ? { jobTitle: author.title } : {}) }
          : { '@id': org['@id'] },
        ...(keywords?.length ? { keywords: keywords.join(', '), articleSection: keywords[0] } : {}),
        ...(wordCount ? { wordCount } : {}),
        ...(readingMinutes ? { timeRequired: `PT${readingMinutes}M` } : {}),
        ...(ogImage
          ? { image: { '@type': 'ImageObject', url: ogImage.href, width: 1200, height: 630 } }
          : {}),
      }
    : {
        '@type': 'WebSite',
        // Scoped to the locale home, so two languages never assert two different
        // descriptions for one @id. English is unchanged: its home IS the site root.
        '@id': `${homeUrl}#website`,
        name: SITE_TITLE,
        alternateName: 'Cirrus Quit',
        description: t.meta.description,
        url: homeUrl,
        inLanguage: lang,
        publisher: { '@id': org['@id'] },
      };

const graph: Record<string, unknown>[] = [org, primary];

// The app itself, live on both stores since Sep 12 2026. MobileApplication is
// schema.org's SoftwareApplication subtype for store apps. Rated 17+ to match
// docs/06 §2.5 and the App Store's own rating.
if (softwareApp) {
  graph.push({
    '@type': 'MobileApplication',
    // Locale-scoped like WebSite's, so the five home pages describe one app in
    // five languages without asserting five descriptions for a single @id.
    '@id': `${homeUrl}#app`,
    name: SITE_TITLE,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, Android',
    contentRating: '17+',
    alternateName: 'Quit Vaping Tracker - Cirrus',
    // schema.org keywords is a real, read field — unlike <meta name="keywords">,
    // which Google dropped in 2009 and Bing treats as a spam signal.
    keywords:
      'quit vaping, quit vaping app, stop vaping, puff counter, vape tracker, taper off vaping, vaping cravings, vaping withdrawal, nicotine',
    description: t.meta.description,
    // The Free-vs-Premium table's own row names, so the list a crawler reads is
    // the list a visitor reads, in the page's language, with no new strings.
    featureList: Object.values(t.home.plans.rows).map((row) => row.feature),
    url: homeUrl,
    publisher: { '@id': org['@id'] },
    // The two listings are this same app, so they are its sameAs: that is how
    // a crawler joins this page to the store entries it already knows.
    sameAs: [APP_STORE_URL, PLAY_STORE_URL],
    // Free to download on both stores. Premium prices are deliberately absent:
    // each store localises them, so no single figure is true for every reader.
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}

// The blog index as a Blog entity, so the listing itself is machine-readable
// rather than just a page that happens to contain links.
if (blogPosts?.length) {
  graph.push({
    '@type': 'Blog',
    '@id': `${Astro.site?.href}blog#blog`,
    name: fmt(t.chrome.rssTitle, { site: SITE_TITLE }),
    url: new URL('/blog', Astro.site).href,
    inLanguage: lang,
    publisher: { '@id': org['@id'] },
    blogPost: blogPosts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.title,
      url: new URL(post.url, Astro.site).href,
      datePublished: post.date.toISOString(),
    })),
  });
}

if (faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

// Home is always position 1 so the trail Google sees starts at the site root.
const trail = breadcrumbs?.length
  ? [{ label: t.chrome.home, href: homePath }, ...breadcrumbs]
  : null;

if (trail) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.label,
      ...(crumb.href ? { item: new URL(crumb.href, Astro.site).href } : {}),
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// English until a locale has posts of its own (Phase 3); link() says so in the
// markup rather than guessing a /es/blog that does not exist.
const blogLink = link(lang, '/blog');

// The language switcher. Each entry goes to THIS page in that language when it
// exists there, and to that language's home when it does not — never to a
// guessed URL. Empty while only one language is live, so an English-only build
// renders no switcher at all.
const languages =
  LIVE_LOCALES.length > 1
    ? LIVE_LOCALES.map((l) => ({
        code: l,
        name: AUTONYM[l],
        href: alternates?.[l] ?? localePath(l, '/'),
        current: l === lang,
      }))
    : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0c10" />
    {/* iPhone Safari's own "open in the App Store" banner. Every other browser
        ignores the tag, so it costs nothing anywhere else. */}
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    {/* Runs before first paint: .reveal only hides content once we know JS is
        alive AND motion is welcome, so a failed observer can never leave the
        page blank. */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('motion');
        // Which store goes first (StoreBadges, AppDemo). Stamped before paint so
        // the badges never visibly reorder. iPadOS reports itself as a Mac, so a
        // touch-capable "Macintosh" is an iPad.
        var ua = navigator.userAgent;
        r.setAttribute('data-os', /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
          ? 'ios' : /Android/i.test(ua) ? 'android' : 'desktop');
      })();
    </script>

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-inter" preload />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map(([l, path]) => <link rel="alternate" hreflang={HREFLANG[l]} href={new URL(path, Astro.site)} />)}
    {hreflangs.length > 0 && alternates?.[DEFAULT_LOCALE] && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LOCALE], Astro.site)} />
    )}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* SVG first for crisp tabs; PNGs for browsers that ignore it. Every one of
        them is generated from the app's own launcher art by scripts/icons.py
        (`npm run icons`), so the tab, the home screen and the phone carry the
        same mark. The touch icon is deliberately square: iOS applies its own
        squircle and would round a pre-rounded source twice. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={fmt(t.chrome.rssTitle, { site: SITE_TITLE })}
      href={new URL('rss.xml', Astro.site)}
    />

    <meta property="og:type" content={type} />
    {/* Home passes no `title`, and falling back to the bare brand made every
        shared link to the home page read "Cirrus" and nothing else. */}
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {hreflangs.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {/* Declared so scrapers can lay the card out before the image downloads. */}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">{t.chrome.skip}</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homePath}>
          {/* Height only — Astro takes the width from the file, so the mark
              cannot be squashed by a hardcoded ratio that drifts when the art
              is redrawn. */}
          <Image src={mark} height={30} layout="fixed" alt="" />
          <span>{SITE_TITLE}</span>
        </a>
        <nav class="site-nav" aria-label={t.chrome.navLabel}>
          <a {...blogLink}>{t.chrome.blog}</a>
          {languages.length > 0 && (
            <details class="lang">
              <summary aria-label={`${t.chrome.language}: ${AUTONYM[lang]}`}>{lang.toUpperCase()}</summary>
              <ul class="lang__panel">
                {languages.map((l) => (
                  <li>
                    {l.current ? (
                      <span aria-current="true">{l.name} <small>{l.code}</small></span>
                    ) : (
                      <a href={l.href} hreflang={HREFLANG[l.code]} lang={l.code}>{l.name} <small>{l.code}</small></a>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )}
          {/* Home scrolls to its own closing band (badges + QR code); every other
              page goes to /download, which puts the reader's store first. "Home"
              is THIS locale's home — testing for "/" sent the Spanish home page's
              button to the English /download. */}
          <a class="btn btn-primary btn-sm" href={cleanPath === homePath ? '#get' : link(lang, '/download').href}>{t.chrome.getApp}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      {
        trail && (
          <nav class="breadcrumb wrap" aria-label={t.chrome.breadcrumbLabel}>
            <ol>
              {trail.map((crumb, i) => (
                <li>
                  {crumb.href && i < trail.length - 1 ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <a class="brand" href={homePath}>
          <Image src={mark} height={24} layout="fixed" alt="" />
          <span style="font-size:1rem">{SITE_TITLE}</span>
        </a>
        <p style="margin:0">{t.chrome.footerLine}</p>
        <div class="footer-links">
          <a {...blogLink}>{t.chrome.blog}</a>
          {/* The legal pages are English-only on purpose: their URLs are frozen by
              the stores and the apps, and a translated policy is a second legal
              text. link() flags them hreflang="en" from a localized page. */}
          <a {...link(lang, PRIVACY_URL)}>{t.chrome.privacy}</a>
          <a {...link(lang, TERMS_URL)}>{t.chrome.terms}</a>
          {/* Play's User Data policy wants the deletion route findable without
              a login and without the app. Last in the row, not hidden: burying
              it is the specific thing the policy exists to stop. */}
          <a {...link(lang, DELETE_ACCOUNT_URL)}>{t.chrome.deleteAccount}</a>
        </div>
        {languages.length > 0 && (
          <nav class="footer-langs" aria-label={t.chrome.language}>
            {languages.map((l) =>
              l.current ? (
                <span aria-current="true">{l.name}</span>
              ) : (
                <a href={l.href} hreflang={HREFLANG[l.code]} lang={l.code}>{l.name}</a>
              ),
            )}
          </nav>
        )}
      </div>
    </footer>

    {/* Scroll reveal. Fires once per element, then a 2.5s failsafe force-reveals
        anything the observer missed and disconnects — content must never be
        left hidden by a script that did not run. */}
    <script>
      const els = document.querySelectorAll('.reveal');
      if (els.length && document.documentElement.classList.contains('motion')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
        setTimeout(() => {
          els.forEach((el) => el.classList.add('in-view'));
          io.disconnect();
        }, 2500);
      }
    </script>
  </body>
</html>
