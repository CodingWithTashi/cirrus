---
// The taper curve, recreated as inline SVG from the app's onboarding "Pick your
// pace" screen. Inline rather than a screenshot: it is ~2KB, stays sharp on any
// display, and the numbers come from the real TaperEngine formula rather than
// a designer's guess at a nice-looking line.
//
// TaperEngine (lib/domain/logic/taper_engine.dart):
//   limit(d) = round(B × (1 − d/P)^1.5), with a fixed tail of ≤3, ≤1, 0.
// Worked example from docs/03 §3.1 — B=150 over P=30 days.

const B = 150; // baseline puffs/day
const P = 30; // days
const W = 620;
const H = 200;
const PAD = { l: 8, r: 8, t: 16, b: 8 };

const limit = (d: number) => {
  if (d >= P) return 0;
  if (d === P - 1) return 1;
  if (d === P - 2) return 3;
  return Math.round(B * Math.pow(1 - d / P, 1.5));
};

const pts = Array.from({ length: P + 1 }, (_, d) => {
  const x = PAD.l + ((W - PAD.l - PAD.r) * d) / P;
  const y = PAD.t + (H - PAD.t - PAD.b) * (1 - limit(d) / B);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});

const line = `M${pts.join(' L')}`;
const area = `${line} L${W - PAD.r},${H - PAD.b} L${PAD.l},${H - PAD.b} Z`;
const [endX, endY] = pts[pts.length - 1].split(',');
---

<figure class="curve">
  <figcaption class="curve-caption">
    <span>150 puffs</span>
    <span class="curve-caption-mid">your curve</span>
    <span>0 puffs</span>
  </figcaption>

  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="A curve falling from 150 puffs a day to zero over 30 days, ending at Freedom Day."
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id="curve-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#c8f542" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#c8f542" stop-opacity="0" />
      </linearGradient>
    </defs>

    <path d={area} fill="url(#curve-fill)" />
    <path
      class="curve-line"
      d={line}
      fill="none"
      stroke="#c8f542"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle class="curve-end" cx={endX} cy={endY} r="6" fill="#ff8a00" />
  </svg>

  <figcaption class="curve-caption">
    <span>Today</span>
    <span class="curve-freedom">Freedom Day</span>
  </figcaption>
</figure>

<style>
  .curve {
    margin: 0;
    background: var(--slate);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
  }

  .curve svg {
    width: 100%;
    height: 200px;
    display: block;
    margin: 0.5rem 0;
  }

  .curve-caption {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .curve-caption-mid { color: var(--muted); }
  .curve-freedom { color: var(--ember); font-weight: 600; }

  /* Draw the line on first paint. The dash length is the path length rounded
     up — an exact measure would need JS, and overshooting is invisible. */
  .curve-line {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: curve-draw 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .curve-end {
    opacity: 0;
    animation: curve-dot 0.4s ease-out 1.4s forwards;
    filter: drop-shadow(0 0 8px rgb(255 138 0 / 0.7));
  }

  @keyframes curve-draw { to { stroke-dashoffset: 0; } }
  @keyframes curve-dot { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .curve-line,
    .curve-end {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
