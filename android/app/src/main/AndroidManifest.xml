<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Connectivity probe + the (future) real backend. Debug/profile builds
         inherit this from Flutter's tooling manifests; release needs it here. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ requires a runtime grant before any notification can be
         shown. Asked from the onboarding D4 screen, never cold. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Danger-hour and trial reminders are scheduled on-device (docs/03 SS8)
         as INEXACT alarms, deliberately. The two exact-alarm permissions are
         NOT the same door. USE_EXACT_ALARM is closed to us - calendar and
         alarm-clock apps only - and the Sep 2026 submission was rejected for
         declaring it. SCHEDULE_EXACT_ALARM is open (Play names it as the
         fallback), but it is denied by default on Android 14+, the only way
         to get it is to send the user to Settings > Special app access >
         Alarms & reminders, and it stays revocable - so the inexact path
         ships either way. Founder decision Sep 2 2026: we do not take it.
         The nudge fires 10 minutes ahead of the risky hour
         (ReminderPlanner.leadMinutes), and an inexact alarm may run late but
         NEVER early, so the timing lever is a longer lead, not a permission.
         Neither goes back in without revisiting that decision;
         test/android_manifest_test.dart fails if one returns. -->
    <!-- Lets the plugin re-arm pending reminders after a reboot or an app
         update. A normal permission; Play does not restrict it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- The advertising ID, removed rather than declared. NOTHING in this app
         reads one: firebase_analytics pulls it in transitively
         (play-services-measurement-api -> the AD_ID permission, and
         play-services-ads-identifier alongside it), so Play's console asks
         "your app declares the advertising ID, confirm or remove" about a
         permission no line of our code uses.

         Removing it costs nothing we have. The advertising ID buys Google Ads
         audience export and ads attribution; docs/05's attribution row defers
         an MMP to "month 3+ ... don't pay for one before you run paid
         traffic", and docs/08's launch engine is organic TikTok, creator
         deals, Apple Search Ads (iOS/IDFA) and SEO. Everything we actually
         read off Firebase Analytics - funnels, retention, Remote Config
         targeting, Crashlytics audiences - works without it.

         It buys a cost, though: an app about quitting nicotine would have to
         disclose an advertising identifier on the Play Data Safety form.
         "We never sell your data" starts with not collecting it - the same
         reason locationListening is off in AmplitudeAnalytics.

         The other half of this decision is in that file: Amplitude's
         TrackingOptions.adid defaults to TRUE, so the SDK attaches an
         advertising ID to every Android event, and the ads-identifier library
         Firebase drags in is what lets it succeed. The permission and that
         flag are one decision in two files; android_manifest_test.dart pins
         both. ACCESS_ADSERVICES_ATTRIBUTION stays - it is the Privacy Sandbox
         measurement API, is not an identifier, and Play restricts neither it
         nor asks about it. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <application
        android:label="Cirrus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Portrait only (android:screenOrientation below). Every one of the
             52 design frames is portrait and nothing has a landscape layout,
             so a rotated phone rendered the app into a viewport it was never
             drawn for. Locked here AND in main.dart, because the manifest
             cannot cover iOS later. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links, verified against
                 https://cirrusquit.com/.well-known/assetlinks.json (served with
                 an application/json Content-Type by the site's public/_headers).

                 THE PATHS ARE SCOPED ON PURPOSE. Claiming the whole host would
                 be actively harmful in two ways:
                   * lp_links.dart opens https://cirrusquit.com/privacy in a
                     browser. Under an unscoped claim that intent comes straight
                     back to us, so "Privacy policy" inside the app would
                     re-open the app - an unescapable loop, on a screen every
                     Play reviewer opens.
                   * every shared blog URL would open the app instead of the
                     article, taking the SEO traffic away from the very people
                     most likely to pass a link on.

                 The apex host ONLY: www.cirrusquit.com 301s to the apex, and
                 Google's Digital Asset Links verifier does not follow
                 redirects, so declaring both hosts fails verification for the
                 whole set rather than just the www one.

                 Verify with:
                   adb shell pm get-app-links com.quitvape.last_puff -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="cirrusquit.com"
                    android:pathPrefix="/download"/>
                <!-- /go/* is NOT claimed yet, deliberately. The site serves no
                     such path (it would 404 for anyone without the app) and
                     nothing in the app routes an incoming link yet, so
                     claiming it would be a door with nothing behind it -
                     the same defect as the dead store links in the blog.
                     It goes back the moment LpDeepLinks and the /go/ page
                     exist, and android_manifest_test.dart pins that pairing. -->
            </intent-filter>
            <!-- Flutter's own deep-link handling is OFF: go_router's routes are
                 internal paths (/home, /paywall), and the engine would push the
                 incoming web path straight at the router - so cirrusquit.com/
                 download becomes a go_router lookup for "/download", which does
                 not exist and lands on RouteNotFoundScreen. It would also skip
                 the redirect guards that send an unauthenticated visitor to
                 /auth and hold a day-one account on /day1. Incoming links get
                 mapped explicitly instead.

                 This MUST sit inside <activity>: Flutter reads it with
                 getActivityInfo(GET_META_DATA), so in <application> it is
                 silently ignored - and since Flutter 3.24 deep linking
                 defaults to ON as soon as an autoVerify filter exists, which
                 is precisely the case above. android_manifest_test.dart
                 asserts the placement, not just the presence. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- Background FCM pushes land in this channel. It is CREATED by
             PushService.ensureAndroidChannel() at startup — the manifest only
             names it, and naming a channel nothing created files every push
             under the plugin's "Miscellaneous" fallback. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />

        <!-- flutter_local_notifications delivers every scheduled notification
             to ScheduledNotificationReceiver via AlarmManager, and since the
             plugin's v16 it declares NOTHING but POST_NOTIFICATIONS and
             VIBRATE in its own manifest - these two receivers are the host
             app's job. Without them the alarm is set, no error is logged, and
             the notification simply never appears; the boot receiver is what
             re-arms the pending ones after a restart. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Home-screen widget (docs/03 SS10, docs/08 B14/B21). One provider,
             two layouts: it reflows from 2x2 to 4x2 rather than shipping two
             entries in the picker.

             NOT exported. Every filter below carries either a protected system
             action (APPWIDGET_UPDATE, sent only by AppWidgetService) or one of
             our own two, which only the PendingIntents this provider hands the
             launcher can fire. Exported, any app on the device could broadcast
             .PLUS and write puffs into someone's own record.

             android:name comes first because test/android_widget_test.dart and
             test/android_manifest_test.dart both read receivers with
             `<receiver[^>]*android:name="([^"]+)"` - an attribute that lands
             after the opening tag's `>` is invisible to them.

             No new permission, and none needed: the tap is a broadcast to our
             own component, and the repaint across midnight is
             updatePeriodMillis (an inexact, batched, non-wakeup alarm the
             framework owns). Nothing here goes near SCHEDULE_EXACT_ALARM. -->
        <receiver
            android:name="com.quitvape.last_puff.widget.CirrusWidgetProvider"
            android:label="@string/cw_picker_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.quitvape.last_puff.widget.PLUS"/>
                <action android:name="com.quitvape.last_puff.widget.MINUS"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cirrus_widget_info"/>
        </receiver>

        <!-- Delivers the midnight repaint. The day number and the count both
             change at local midnight and nothing repaints a widget on its own;
             home_widget arms one alarm per provider for the next scheduled
             time and this receiver both consumes it and arms the following
             one. It also re-arms everything after a reboot or an app update,
             which is what RECEIVE_BOOT_COMPLETED - already declared above for
             flutter_local_notifications - does double duty for.

             The plugin deliberately does NOT declare this itself, precisely so
             that apps which never schedule an update do not inherit the boot
             permission. An unregistered receiver never gets the alarm and the
             widget silently shows yesterday until the 30-minute
             updatePeriodMillis floor catches it; HomeWidgetScheduler only logs
             a warning.

             INEXACT, and that is the point: HomeWidgetScheduler calls
             canScheduleExactAlarms() and falls back to setAndAllowWhileIdle
             when it is false, which it always is here. The plugin documents a
             third action for this filter,
             SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED; it is deliberately
             OMITTED, because it can only ever fire for an app holding that
             permission - which this one never will (founder decision Sep 2
             2026) - and it would put that string into a manifest whose test
             file exists to keep it out. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetScheduledUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
