{
  "name": "lastpuff-functions",
  "version": "1.0.0",
  "description": "LastPuff Cloud Functions \u2014 AI coach, moderation, entitlements, crons.",
  "private": true,
  "type": "commonjs",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "npm run verify && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
