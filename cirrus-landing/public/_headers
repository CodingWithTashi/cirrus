# Cloudflare Pages reads this at the edge. Order matters: later rules win.

/*
  # HSTS. Pages already 301s http->https, but this stops the browser from
  # making the insecure request at all on repeat visits. No `preload` — that
  # is a one-way submission to a browser-baked list, so opt in deliberately.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro fingerprints these filenames, so the content at a given URL never
# changes. Pages' default is max-age=14400 + must-revalidate, which makes every
# repeat visitor re-check fonts and CSS that provably cannot have changed —
# wasted round trips against Core Web Vitals.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything below lives at a FIXED, unhashed URL, so none of it can carry
# `immutable` the way /_astro/* does — a year-long cache would strand a bad
# favicon or a stale social card on every repeat visitor with no way to bust it.
# A week is long enough that nobody re-fetches these in practice, and short
# enough that a fix actually reaches people.
#
# Content imagery is deliberately absent from this list: it now goes through
# astro:assets, lands in /_astro/* with a content hash, and is already covered
# by the immutable rule above.

/og.png
  Cache-Control: public, max-age=604800

# Per-post social cards from `npm run og`. Scoped to the directory, so it does
# not collide with the /og.png rule above.
/og/*
  Cache-Control: public, max-age=604800

# Not rendered anywhere on the site. This is the Organization.logo URL inside
# the JSON-LD, so it has to stay a stable raster PNG that crawlers can fetch —
# do not point structured data at a hashed /_astro/ file.
/logo.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon-16.png
  Cache-Control: public, max-age=604800

/favicon-32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Android App Links. Google's verifier fetches this over HTTPS and requires
# `application/json`; Pages would otherwise serve a bare .json from a dot-
# directory with a guessed type, and verification fails with no error anywhere
# a developer would look — the links simply keep opening the browser.
#
# Two more things this file depends on, neither of them expressible here:
#   1. The verifier does NOT follow redirects, and www.cirrusquit.com 301s to
#      the apex — so the app's intent-filter declares the apex host ONLY.
#   2. The app claims /download and /go/* and nothing else. An unscoped claim
#      would make the in-app "Privacy" link re-open the app, and would hijack
#      every shared blog URL away from the site.
#
# An hour, not a week: adding a fingerprint (a new signing key, a second app)
# should reach Google quickly, and this file is fetched rarely enough that the
# short TTL costs nothing.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
