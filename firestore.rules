rules_version = '2';

// LastPuff security rules.
//
// The load-bearing idea is a split of ownership (see functions/src/lib/firestore.ts):
//
//   journeys/{uid}   CLIENT-owned. The app writes the whole document on every
//                    optimistic mutation, so no server field may live here.
//   users/{uid}      SERVER-owned. Entitlement, AI usage and taper advice.
//                    Readable by its owner, writable ONLY by Cloud Functions
//                    (the Admin SDK bypasses these rules by design).
//
// If a client could write users/{uid}.entitlement it would grant itself
// Premium and unmetered model calls. That single line is why the split exists.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** Keys changed by this update, whatever their values. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** A report is a +1 or nothing — never an arbitrary assignment. */
    function reportCountOnlyIncrements() {
      return !changed().hasAny(['reportCount'])
             || request.resource.data.reportCount == resource.data.reportCount + 1;
    }

    // --- The quit journey: private, client-owned -------------------------
    match /journeys/{uid} {
      allow read, write: if isOwner(uid);
    }

    // --- Server-owned private state --------------------------------------
    // Writes go through callables (syncUserContext, panicSession) or the
    // RevenueCat webhook. Never directly.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // --- Community feed ---------------------------------------------------
    match /posts/{postId} {
      // 'pending' and 'blocked' posts are genuinely invisible, not merely
      // unrendered — nothing reaches a reader before moderatePost clears it.
      allow read: if signedIn() && resource.data.status == 'live';

      // Creation goes through the createPost callable so the author uid is
      // stamped into postAuthors instead of onto the post (docs/05 §6).
      allow create: if false;
      allow delete: if false;

      // reportCount is now the ONLY client-writable field. Reaction counts
      // moved to being derived server-side from the reactors subcollection
      // below, because a client that can write the count can invent any
      // popularity it likes.
      //
      // hasOnly() constrains WHICH keys move, not how far. Without the
      // increment rule below, a client could write reportCount: 0 to erase
      // accumulated reports, or reportCount: 9999 to fake a pile-on and
      // auto-hide someone else's post. Reporting is a +1, never an assignment.
      allow update: if signedIn()
                    && changed().hasOnly(['reportCount'])
                    && request.resource.data.status == resource.data.status
                    && reportCountOnlyIncrements();

      // One document per person, keyed by their uid, readable and writable
      // ONLY by them.
      //
      // The obvious alternative — a {uid: emoji} map on the post itself —
      // would have de-anonymized the whole feed: the post is readable by
      // every signed-in user, so every uid that reacted would be public.
      // Splitting it this way keeps the aggregate counts public and the
      // identities private, and it is also what makes "did I react?"
      // answerable without trusting the client to remember.
      // `uid` is duplicated into the document body on purpose. A collection
      // group query is only allowed when the rules can PROVE from the query
      // itself that it returns nothing forbidden, and a path wildcard is not
      // provable that way — so "which posts did I react to?" has to filter on
      // a field. The write rule keeps the field and the document id in step.
      match /reactors/{uid} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        // Split from create/update because `request.resource` is null on a
        // delete, so the field check below would error rather than pass.
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.uid == uid;
      }

      // A reply is UGC too, so it gets the same moderation gate as a post:
      // Guideline 1.2 does not care that this one is nested. Replies are
      // written 'pending' and flipped live by moderatePost.
      match /replies/{replyId} {
        allow read: if signedIn() && resource.data.status == 'live';
        allow create: if false;   // createReply callable (same reason as posts)
        allow update, delete: if false;
      }
    }

    // --- Collection-group reads ------------------------------------------
    //
    // A nested `match` under /posts/{postId} does NOT apply to a
    // `collectionGroup()` query. Firestore evaluates those against a
    // recursive-wildcard path, and without one every group query is denied —
    // which is exactly what happened: `FirebaseCommunityRepository.fetchPosts`
    // issues group queries for replies and for the viewer's own reactions, so
    // the community feed failed to load for every user on the real backend,
    // while the rules suite (which only ever tested direct document paths)
    // stayed green. Found by the end-to-end run.
    //
    // Both are read-only and carry the same predicate as their nested twin, so
    // this widens the PATH the rule is reachable from, never the data it
    // exposes. Writes stay with the nested rules; the default deny below
    // covers them here.
    match /{path=**}/replies/{replyId} {
      allow read: if signedIn() && resource.data.status == 'live';
    }

    // "Which posts did I react to?" — provable only because the query filters
    // on the duplicated `uid` field, which is why that field exists.
    match /{path=**}/reactors/{reactorId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Server-only collections -----------------------------------------
    // postAuthors is the uid ↔ post mapping that lets account deletion find a
    // user's posts. Exposing it would defeat the anonymity of the whole feed.
    match /postAuthors/{postId} {
      allow read, write: if false;
    }

    // Same reasoning for replies: the mapping is what makes account deletion
    // able to find someone's replies without a uid ever touching the reply.
    match /replyAuthors/{replyId} {
      allow read, write: if false;
    }

    // The founder's moderation review queue.
    match /moderation/{postId} {
      allow read, write: if false;
    }

    // Beta-tester quotes for the D3 rating ask. Reached only through the
    // matchedTestimonials callable, which returns the two fields the screen
    // renders — the rows themselves carry consent references and translation
    // provenance that no client needs. Written by the seeder (Admin SDK).
    //
    // Explicit rather than left to the default deny below, so that adding a
    // reader later is a deliberate edit here and not an accident.
    match /testimonials/{id} {
      allow read, write: if false;
    }

    // Default deny. Any collection added later is closed until it is
    // deliberately opened here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
