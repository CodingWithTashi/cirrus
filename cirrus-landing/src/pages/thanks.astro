---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, LAUNCH_DATE_LABEL } from '../consts';

// noindex: a confirmation page has no search value and would compete with the
// landing page for brand queries. It is also excluded from the sitemap.
---

<BaseLayout
  title="You're on the list"
  description="Confirm your email to finish joining the Cirrus waitlist."
  noindex
>
  <h1>Almost — check your email.</h1>
  <p class="lede">
    We've sent a confirmation link. Clicking it is the bit everyone forgets, and without it we
    can't email you when {SITE_TITLE} lands.
  </p>
  <p>
    Android arrives {LAUNCH_DATE_LABEL}; iPhone follows. Nothing else will land in your inbox in
    the meantime.
  </p>
  <p><a href="/">Back to the home page</a></p>
</BaseLayout>
