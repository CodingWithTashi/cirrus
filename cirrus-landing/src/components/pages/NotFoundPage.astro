---
// Every other page wraps its content in `.wrap .page`; this one did not, so it
// rendered with no gutter and no vertical padding — the heading and both lines
// sat hard against the left edge of the viewport and were clipped on narrow
// screens. `.wrap` is what supplies the gutter, `.page` the block padding.
//
// A 404 is a dead end, so it offers the two things somebody who mistyped a URL
// is most likely to have been looking for rather than only the home page.
//
// Cloudflare Pages serves the nearest 404.html up the tree, so dist/es/404.html
// answers a bad URL under /es in Spanish and this one answers everything else.
// `astro dev` always shows the English one; `npm run preview:edge` shows the truth.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DOWNLOAD_URL } from '../../lib/store.ts';
import { useT, type Locale } from '../../i18n/index.ts';
import { DEFAULT_LOCALE } from '../../i18n/locales.mjs';
import { link } from '../../i18n/paths.ts';

interface Props { lang?: Locale }
const { lang = DEFAULT_LOCALE } = Astro.props;
const t = useT(lang).notFound;
const blog = link(lang, '/blog');
---

<BaseLayout lang={lang} title={t.title} description={t.description} noindex>
  <div class="wrap page">
    <h1>{t.h1}</h1>
    <p class="lede">{t.lede}</p>
    <p>
      <a href={link(lang, '/').href}>{t.home}</a> · <a href={link(lang, DOWNLOAD_URL).href}>{t.getApp}</a> ·
      <a {...blog}>{t.blog}</a>
    </p>
  </div>
</BaseLayout>
