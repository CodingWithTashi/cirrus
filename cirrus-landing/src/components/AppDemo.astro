---
// Cirrus's onboarding step 5, rebuilt as live UI you can actually tap.
//
// Renders in two halves so the phone can live in the hero while the derived
// money + curve sit in their own section: <AppDemo part="phone" /> and
// <AppDemo part="output" />. One script, included with the phone, wires both by
// querying the document — neither half needs to know where the other is.
//
// Not a screenshot and not a "widget" that merely borrows the numbers — this is
// the screen, keypad and all, running in the browser. docs/06 §4 already names
// this the ASO thumb-stopper, so it is the right thing to hand a stranger.
//
// Every output mirrors real Dart in lib/domain/logic/:
//   DependenceLevel.forPuffs  — <=50 light, <=150 moderate, <=300 heavy, 301+ severe
//   DependenceEngine          — round(puffs / 14) cigarettes; ~600 puffs a disposable
//   TaperEngine               — round(B * (1 - d/P)^1.5) with the <=3, <=1, 0 tail
//   MoneyEngine               — the visitor's own spend x52. Their arithmetic, not ours.
//
// LANGUAGE. The markup renders from the dictionary like any other component.
// The script cannot: Astro bundles it once for every page, so it has no `lang`
// and no way to import a dictionary per page. The strings it swaps at runtime
// travel in a JSON data island beside the phone instead — NOT `define:vars`,
// which forces the script inline and unbundled on every page that has it.
import { appStoreUrl, campaignFor, playUrl } from '../lib/store';
import { useT, type Locale } from '../i18n/index.ts';
import { DEFAULT_LOCALE, DEMO_CURRENCY, INTL } from '../i18n/locales.mjs';

interface Props { part?: 'phone' | 'output'; lang?: Locale }
const { part = 'phone', lang = DEFAULT_LOCALE } = Astro.props;
const t = useT(lang).demo;

// The currency is config, not copy (see DEMO_CURRENCY): a symbol is a guess about
// where the reader lives, so locales that serve more than one currency zone show
// the bare number — always honest, because the arithmetic is the visitor's own.
const currency = DEMO_CURRENCY[lang];
const money = currency
  ? new Intl.NumberFormat(INTL[lang], { style: 'currency', currency, maximumFractionDigits: 0 })
  : new Intl.NumberFormat(INTL[lang], { maximumFractionDigits: 0 });

// Where the symbol sits relative to the amount ("$20" but "20 €"), read from
// Intl rather than assumed.
const parts = currency ? money.formatToParts(20) : [];
const symbol = parts.find((p) => p.type === 'currency')?.value ?? '';
const symbolFirst = parts.findIndex((p) => p.type === 'currency') < parts.findIndex((p) => p.type === 'integer');

// Everything the script needs that depends on the page's language. `<` is
// escaped so no string can ever close the <script> element it sits in.
const island = JSON.stringify({
  intl: INTL[lang],
  currency,
  askPuffs: t.askPuffs,
  askDevices: t.askDevices,
  toDevices: t.toDevices,
  toPuffs: t.toPuffs,
  bands: {
    empty: { label: t.bandEmpty, quip: t.quipEmpty },
    light: { label: t.bandLight, quip: t.quipLight },
    moderate: { label: t.bandModerate, quip: t.quipModerate },
    heavy: { label: t.bandHeavy, quip: t.quipHeavy },
    severe: { label: t.bandSevere, quip: t.quipSevere },
  },
}).replace(/</g, '\\u003c');
---

{part === 'phone' && (
  <div class="phone phone--live" data-demo>
    <script type="application/json" id="demo-i18n" is:inline set:html={island} />
    <div class="app">
      <p class="app__q" data-mode-label>{t.askPuffs}</p>

      <div class="app__readout">
        <div class="app__numrow">
          <p class="app__num" data-num aria-live="polite">150</p>
          <div class="app__stepper">
            <button type="button" data-step="up" aria-label={t.increase}>▲</button>
            <button type="button" data-step="down" aria-label={t.decrease}>▼</button>
          </div>
        </div>
        <p class="app__badge"><span class="badge" data-badge data-level="moderate">{t.bandModerate}</span></p>
        <p class="app__equiv">{t.equivPre}<b data-cigs>11</b>{t.equivPost}</p>
        <p class="app__quip" data-quip>{t.quipModerate}</p>
      </div>

      <button class="app__alt" type="button" data-toggle-mode>
        {t.toDevices}
      </button>

      <div class="app__pad" data-pad role="group" aria-label={t.padLabel}>
        <button type="button" data-key="1">1</button>
        <button type="button" data-key="2">2</button>
        <button type="button" data-key="3">3</button>
        <button type="button" data-key="4">4</button>
        <button type="button" data-key="5">5</button>
        <button type="button" data-key="6">6</button>
        <button type="button" data-key="7">7</button>
        <button type="button" data-key="8">8</button>
        <button type="button" data-key="9">9</button>
        <span></span>
        <button type="button" data-key="0">0</button>
        <button type="button" data-key="del" aria-label={t.del}>⌫</button>
      </div>

      {/* A real link, so it works with JS off: it scrolls to the badges and the
          QR code. On a phone the script points it at that phone's store. */}
      <a
        class="app__cta btn btn-primary"
        href="#get"
        data-continue
        data-ios={appStoreUrl()}
        data-android={playUrl(campaignFor(lang, 'hero-demo'))}
      >
        {t.cta}
      </a>
    </div>
  </div>
)}

{part === 'output' && (
  <div class="demo__out" data-demo-out>
    <p class="micro micro--volt">{t.outEyebrow}</p>

    <div class="demo__money">
      <label class="micro" for="demo-spend">{t.spendLabel}</label>
      <div class="field__box">
        {symbol && symbolFirst && <span aria-hidden="true">{symbol}</span>}
        <input id="demo-spend" type="number" inputmode="decimal" min="0" max="1000" step="5" value="20" data-spend />
        {symbol && !symbolFirst && <span aria-hidden="true">{symbol}</span>}
        <span>{t.perWeek}</span>
      </div>
      <p class="demo__year" data-year aria-live="polite">{money.format(20 * 52)}</p>
      <p class="micro">{t.yearNote}</p>
    </div>

    <figure class="demo__curve">
      <figcaption class="curve-caption">
        <span><b data-start>150</b>{t.startSuffix}</span>
        <span class="curve-freedom">{t.freedom}</span>
      </figcaption>
      <svg viewBox="0 0 460 120" preserveAspectRatio="none" role="img"
           aria-label={t.curveLabel}>
        <defs>
          <linearGradient id="d-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#c8f542" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#c8f542" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path data-area fill="url(#d-fill)" d="" />
        <path data-line fill="none" stroke="#c8f542" stroke-width="3"
              stroke-linecap="round" stroke-linejoin="round" d="" />
        <circle data-end r="5.5" fill="#ff8a00" />
      </svg>
      <figcaption class="micro" style="text-align:center;margin-top:0.6rem">
        {t.curveCaption}
      </figcaption>
    </figure>
  </div>
)}

<script>
  type Band = { label: string; quip: string };
  type DemoI18n = {
    intl: string;
    currency: string | null;
    askPuffs: string;
    askDevices: string;
    toDevices: string;
    toPuffs: string;
    bands: Record<'empty' | 'light' | 'moderate' | 'heavy' | 'severe', Band>;
  };

  const root = document.querySelector<HTMLElement>('[data-demo]');
  const island = document.getElementById('demo-i18n');
  if (root && island) {
    // The page's language, handed over by the component that rendered it.
    const i18n = JSON.parse(island.textContent ?? '{}') as DemoI18n;

    // Both halves may be in different sections, so resolve against the document.
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const numEl = $<HTMLElement>('[data-num]');
    const badge = $<HTMLElement>('[data-badge]');
    const cigs = $<HTMLElement>('[data-cigs]');
    const quip = $<HTMLElement>('[data-quip]');
    const equiv = $<HTMLElement>('.app__equiv');
    const label = $<HTMLElement>('[data-mode-label]');
    const alt = $<HTMLButtonElement>('[data-toggle-mode]');
    const spendEl = document.querySelector<HTMLInputElement>('[data-spend]');
    const yearEl = document.querySelector<HTMLElement>('[data-year]');
    const startEl = document.querySelector<HTMLElement>('[data-start]');
    const line = document.querySelector<SVGPathElement>('[data-line]');
    const area = document.querySelector<SVGPathElement>('[data-area]');
    const end = document.querySelector<SVGCircleElement>('[data-end]');

    // A currency where the locale has exactly one to show; a bare, locale-grouped
    // number where it does not. Same rule the server used for the first paint.
    const money = i18n.currency
      ? new Intl.NumberFormat(i18n.intl, { style: 'currency', currency: i18n.currency, maximumFractionDigits: 0 })
      : new Intl.NumberFormat(i18n.intl, { maximumFractionDigits: 0 });

    // Two input modes, exactly like the app: type puffs directly, or estimate
    // from how many disposables you get through (~600 puffs each).
    let mode: 'puffs' | 'devices' = 'puffs';
    let entry = '150';

    const puffsNow = () => {
      const n = Number(entry) || 0;
      return mode === 'puffs' ? n : Math.round((n * 600) / 7);
    };

    // Mirrors DependenceLevel.forPuffs. Copy is warm and never shaming
    // (docs/07 §2 bans shame words) — the joke is always about the vape.
    const bandFor = (p: number) =>
      p <= 0
        ? { key: 'light', ...i18n.bands.empty }
        : p <= 50
          ? { key: 'light', ...i18n.bands.light }
          : p <= 150
            ? { key: 'moderate', ...i18n.bands.moderate }
            : p <= 300
              ? { key: 'heavy', ...i18n.bands.heavy }
              : { key: 'severe', ...i18n.bands.severe };

    const W = 460, H = 120, P = 30;
    const limit = (base: number, d: number) => {
      if (d >= P) return 0;
      if (d === P - 1) return 1;
      if (d === P - 2) return 3;
      return Math.round(base * Math.pow(1 - d / P, 1.5));
    };

    const render = () => {
      const puffs = puffsNow();
      const band = bandFor(puffs);

      numEl.textContent = entry === '' ? '—' : entry;
      badge.textContent = band.label;
      badge.dataset.level = band.key;
      quip.textContent = band.quip;

      equiv.hidden = puffs <= 0;
      cigs.textContent = String(Math.round(puffs / 14));

      if (!spendEl || !yearEl || !startEl || !line || !area || !end) return;
      const spend = Math.min(Math.max(Number(spendEl.value) || 0, 0), 1000);
      yearEl.textContent = money.format(spend * 52);
      startEl.textContent = String(puffs);

      const base = Math.max(puffs, 1);
      const pts: string[] = [];
      for (let d = 0; d <= P; d++) {
        const x = 6 + ((W - 12) * d) / P;
        const y = 10 + (H - 18) * (1 - limit(base, d) / base);
        pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
      }
      const path = `M${pts.join(' L')}`;
      line.setAttribute('d', path);
      area.setAttribute('d', `${path} L${W - 6},${H - 8} L6,${H - 8} Z`);
      const [ex, ey] = pts[pts.length - 1].split(',');
      end.setAttribute('cx', ex);
      end.setAttribute('cy', ey);
    };

    document.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const k = btn.dataset.key!;
        if (k === 'del') entry = entry.slice(0, -1);
        else if (entry.length < 4) entry = (entry === '0' ? '' : entry) + k;
        render();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = mode === 'puffs' ? 10 : 1;
        const max = mode === 'puffs' ? 2000 : 40;
        const next = (Number(entry) || 0) + (btn.dataset.step === 'up' ? step : -step);
        entry = String(Math.min(Math.max(next, 0), max));
        render();
      });
    });

    alt.addEventListener('click', () => {
      mode = mode === 'puffs' ? 'devices' : 'puffs';
      entry = mode === 'puffs' ? '150' : '3';
      label.textContent = mode === 'puffs' ? i18n.askPuffs : i18n.askDevices;
      alt.textContent = mode === 'puffs' ? i18n.toDevices : i18n.toPuffs;
      render();
    });

    // Continue does what it says. On a phone it opens that phone's store; on a
    // computer it keeps its #get href and scrolls to the badges and QR code.
    // `data-os` is stamped on <html> by BaseLayout before first paint.
    const cont = $<HTMLAnchorElement>('[data-continue]');
    const os = document.documentElement.dataset.os;
    if (os === 'ios' && cont.dataset.ios) cont.href = cont.dataset.ios;
    if (os === 'android' && cont.dataset.android) cont.href = cont.dataset.android;

    spendEl?.addEventListener('input', render);
    render();
  }
</script>
