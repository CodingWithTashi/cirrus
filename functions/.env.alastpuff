# Deploy-time parameters for the `alastpuff` project.
#
# SAFE TO COMMIT — configuration only. Secrets (GEMINI_API_KEY,
# REVENUECAT_WEBHOOK_TOKEN) live in Google Secret Manager and must never
# appear here. Local emulator values go in .env.local, which Firebase reads
# for the emulator and never uploads.
#
# These mirror the defaults in src/config.ts. They exist as a file so a
# non-interactive deploy (CI) resolves every param the same way a local one
# does, and so a change to production config is a reviewable diff.

# Pre-monetization: everyone is premium until RevenueCat is wired.
# >>> FLIP TO `mirror` THE DAY BILLING GOES LIVE. <<<
ENTITLEMENT_MODE=ungated

# Warm instances for the coach. 0 for now; 1-2 in production (~$15/mo) so a
# 2am craving does not wait on a cold start.
COACH_MIN_INSTANCES=0

# docs/04 §7. Inert while ENTITLEMENT_MODE=ungated, since everyone resolves
# to the premium allowance.
FREE_DAILY_COACH_MESSAGES=5
PREMIUM_DAILY_COACH_MESSAGES=100

# docs/05 §8 model routing. Params, not constants, so an EOL model is a config
# change rather than a redeploy of new code.
#
# WAS `gemini-3.1-*`, WHICH DOES NOT EXIST. The API answered every coach
# request with `404 models/gemini-3.1-flash is not found for API version
# v1beta`, so Ember returned `connectionLost` to every user, always. Nothing in
# the logs said so until the end-to-end run added the cause to that branch —
# the failure and "nobody used the coach today" looked identical.
#
# >>> 2.5 Flash-Lite RETIRES 2026-10-16 — the day after launch. Confirm the
# >>> current-generation ids against ListModels before then. <<<
MODEL_FREE=gemini-2.5-flash-lite
MODEL_PREMIUM=gemini-2.5-flash
MODEL_MODERATION=gemini-2.5-flash-lite

# Cost kill-switch: "true" routes all coach traffic to the cheap model.
AI_COST_PANIC=false
