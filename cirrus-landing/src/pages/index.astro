---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppDemo from '../components/AppDemo.astro';
import StoreBadges from '../components/StoreBadges.astro';
import qrSvg from '../assets/qr-download.svg?raw';
import homeShot from '../assets/store/home.jpg';
import logShot from '../assets/store/log.jpg';
import planShot from '../assets/store/plan.jpg';
import coachShot from '../assets/store/coach.jpg';
import panicShot from '../assets/store/panic.jpg';
import communityShot from '../assets/store/community.jpg';
import statsShot from '../assets/store/stats.jpg';
import { HONEST_STATS, FAQS } from '../lib/content';

// Three of the five approved stats — the strongest, kept to a three-card
// rhythm. All five remain in content.ts for the blog to use.
const stats = HONEST_STATS.filter((s) => ['76%', '28% → 53%', '15–20 min'].includes(s.figure));

// The App Store listing's own screenshots (the store's 1284×2778 renders,
// resized to 428 wide — 2× the rail's widest card). Each headline is part of
// the image, so the alt text carries it.
const screens = [
  { img: homeShot, alt: "Home: your last puff, tracked. Today's puffs against your limit, money saved and cravings beaten." },
  { img: logShot, alt: "Log a puff in one tap, with this week's bars and the home screen widget." },
  { img: planShot, alt: 'A taper built for you: your daily line drops a little each day to Freedom Day.' },
  { img: coachShot, alt: 'A coach that texts back: Ember knows your plan, your patterns and your weak spot.' },
  { img: panicShot, alt: 'Craving? Hit Panic: a paced breathing exercise that outlasts the urge.' },
  { img: communityShot, alt: 'Quit with people who get it: the anonymous community feed.' },
  { img: statsShot, alt: 'Watch nicotine leave: milligrams per day, trigger hours and health milestones.' },
];

// An example day. The clock times are illustrative and the page says so; every
// feature named is shipped (docs/13) and every tag is its real tier (docs/13 §4).
// No figure appears here beyond the times and the cited craving window.
const day = [
  {
    time: '7:40', ampm: 'am', title: 'First one of the day', tag: 'Free',
    body: 'One tap on LOG PUFF, or the + on your home screen widget without opening the app. A tap is always exactly one puff, with a five-second undo for the mistap.',
  },
  {
    time: '12:30', ampm: 'pm', tone: 'ember', title: 'Lunch goes sideways', tag: 'Free',
    body: "You're over today's limit. No reset, no day one. A repair token you earned with seven clean days absorbs it, so the streak dims instead of dying.",
  },
  {
    time: '2:50', ampm: 'pm', title: 'A heads-up, ten minutes early', tag: 'Free',
    body: "Your trigger-hour heatmap says 3pm is the hard one, so that's the hour you picked. One nudge lands just before it, and never during your quiet hours.",
  },
  {
    time: '3:04', ampm: 'pm', tone: 'oxygen', title: 'The craving shows up anyway', tag: 'Free',
    body: 'Hit Panic. A 4-7-8 breathing pacer, the reason you wrote down on day one, and a game for your thumbs while the wave peaks. It opens every time, on every plan, and the coach door inside it is never locked.',
  },
  {
    time: '3:19', ampm: 'pm', tone: 'ember', title: 'It passed',
    body: "Most cravings are over in 15 to 20 minutes. Tap “It passed” and it's counted as one you beat.",
  },
  {
    time: '11:40', ampm: 'pm', title: "Can't sleep, want one", tag: 'Free · 5 coach messages a day',
    body: 'Message Ember, the AI coach. It already knows your plan day, your limit and that nights are your hard part, so you skip the explaining. Or post an SOS to the anonymous community and it pins to the top of the feed for an hour.',
  },
  {
    time: '12:00', ampm: 'am', title: "Tomorrow's line drops a little", tag: 'Adaptive plan · Premium', pro: true,
    body: 'On a good run the plan speeds up. Two rough days running and it adds runway and moves Freedom Day instead of setting you up to fail.',
  },
];

// Free vs Premium. Every value is a real allowance (docs/13 §4, LpAllowances in
// the app). The coach says "up to 100" because that is what the server enforces,
// even though the store listing is allowed to say unlimited.
const compare: { feature: string; free: string | boolean; pro: string | boolean }[] = [
  { feature: 'Puff counter, widget, edit any day', free: true, pro: true },
  { feature: 'Daily limit tapering to Freedom Day', free: true, pro: true },
  { feature: 'Streak with repair tokens', free: true, pro: true },
  { feature: 'Money saved and savings goals', free: true, pro: true },
  { feature: 'Panic Button', free: 'Always opens · Orbs game', pro: 'Plus Tiles and Blocks' },
  { feature: 'Ember, the AI coach', free: '5 messages a day', pro: 'Up to 100 a day' },
  { feature: 'Anonymous community', free: '1 post a day, plus SOS', pro: '3 posts a day, plus SOS' },
  { feature: 'Recovery timeline', free: 'First 4 milestones, and any you reach', pro: 'All of it' },
  { feature: 'Stats history', free: '7 days', pro: '30 days, month view, craving forecast' },
  { feature: 'Plan that re-adjusts every night', free: false, pro: true },
  { feature: 'Weekly insight report', free: false, pro: true },
  { feature: 'Hearth and Tide themes', free: false, pro: true },
];

// The file is a whole document; only the <svg> belongs inline.
const qr = qrSvg
  .replace(/<\?xml[^>]*\?>/, '')
  .replace(/<!DOCTYPE[^>]*>/, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<BaseLayout softwareApp faq={FAQS}>
  {/* ---------- 1. HERO ---------- */}
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="micro micro--volt">Free on iPhone and Android</p>
        <h1>Quit vaping without going <span class="accent">cold turkey</span>.</h1>
        <p class="hero__sub">
          The quit vaping app that tapers you down instead of demanding you stop dead.
          One bad Tuesday shouldn't cost you three weeks.
        </p>
        <StoreBadges campaign="hero" />
        <ul class="hero__trust">
          <li>Free to start</li>
          <li>Free tier never runs out</li>
          <li>No ad trackers</li>
        </ul>
      </div>

      <AppDemo part="phone" />
    </div>
  </section>

  {/* ---------- 2. WHAT YOUR NUMBER MEANS ---------- */}
  <section class="section section--lift section--rules" aria-labelledby="number">
    <div class="wrap">
      <div class="section__head">
        <p class="micro micro--volt">Live · no signup</p>
        <h2 id="number">What does vaping actually cost you a year?</h2>
        <p>Tap the keypad up there. Everything below moves with it.</p>
      </div>

      <AppDemo part="output" />
    </div>
  </section>

  {/* ---------- 3. AN EXAMPLE DAY ---------- */}
  <section class="section" aria-labelledby="day-h">
    <div class="wrap day">
      <div class="section__head section__head--left">
        <p class="micro">An example day</p>
        <h2 id="day-h">What quitting with Cirrus looks like, hour by hour.</h2>
        <p>
          Day 12 of a 30-day taper. The times are made up; every feature on this rail is in the
          app you download today.
        </p>
      </div>

      <ol class="timeline">
        {
          day.map((step) => (
            <li data-tone={step.tone}>
              <span class="timeline__time">
                {step.time}
                <small>{step.ampm}</small>
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {step.tag && <span class:list={['tag', { 'tag--pro': step.pro }]}>{step.tag}</span>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- 4. SCREENSHOTS ---------- */}
  <section class="section section--lift section--rules" aria-labelledby="inside">
    <div class="wrap">
      <div class="rail-head">
        <div class="section__head section__head--left">
          <p class="micro">Inside the app</p>
          <h2 id="inside">This is the app you'll download.</h2>
          <p>The same screens that are on the store listing.</p>
        </div>
        <p class="micro">{screens.length} screens · swipe →</p>
      </div>

      <div class="rail" tabindex="0" role="region" aria-label="App screenshots">
        {
          screens.map((s) => (
            <figure>
              <Image src={s.img} width={214} sizes="214px" loading="lazy" alt={s.alt} />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 5. DEVICES ---------- */}
  <section class="section section--tight" aria-labelledby="where">
    <div class="wrap">
      <div class="section__head section__head--left">
        <p class="micro">Where it lives</p>
        <h2 id="where">On the phone in your hand, and the wrist it's attached to.</h2>
      </div>

      <ul class="devices">
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="9" y="3" width="14" height="26" rx="3.5"></rect><path d="M14 6.5h4"></path></svg>
          <h3>iPhone</h3>
          <p>On the App Store. iOS 15 or later.</p>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="9" y="3" width="14" height="26" rx="2.5"></rect><circle cx="16" cy="6.3" r="0.6"></circle></svg>
          <h3>Android</h3>
          <p>On Google Play.</p>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="7" width="24" height="18" rx="4"></rect><path d="M20 13v6M17 16h6"></path><path d="M8.5 13h6M8.5 17h4"></path></svg>
          <h3>Home screen widget</h3>
          <p>Log a puff without opening the app, on iPhone and Android.</p>
        </li>
        <li>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="9" y="8" width="14" height="16" rx="4"></rect><path d="M12 8l1-5h6l1 5M12 24l1 5h6l1-5"></path><path d="M16 13v6M13 16h6"></path></svg>
          <h3>Apple Watch</h3>
          <p>Today's count, your limit and a + that logs from your wrist.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* ---------- 6. FREE VS PREMIUM ---------- */}
  <section class="section section--lift section--rules" aria-labelledby="cost">
    <div class="wrap plans">
      <div class="section__head section__head--left">
        <p class="micro micro--volt">What it costs</p>
        <h2 id="cost">The free tier isn't a trial. It doesn't run out.</h2>
        <p>
          Counting, your limit and your streak are the core, so they're free for good. Premium is
          for when you want more help.
        </p>

        {/* The founder-locked prices (docs/08 §1, LpPricing in the app). Real
            prices, not statistics — but US ones, and the note says so. */}
        <div class="price">
          <p class="micro">Premium</p>
          <ul class="price__list">
            <li><b>$2.99</b><span>a week</span></li>
            <li><b>$7.99</b><span>a month</span></li>
            <li><b>$39.99</b><span>a year</span></li>
          </ul>
          <p class="price__note">
            <b>7-day free trial on every plan.</b> US prices; your store shows yours. Billed and
            cancelled through the App Store or Google Play.
          </p>
        </div>
      </div>

      <div class="compare-wrap" tabindex="0" role="region" aria-label="Free and Premium compared">
        <table class="compare">
          <colgroup><col class="compare__feature" /><col /><col /></colgroup>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Free</th>
              <th scope="col" class="compare__pro">Premium</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {[row.free, row.pro].map((value, i) => (
                    <td class:list={{ compare__pro: i === 1 }}>
                      {value === true ? (
                        <span class="compare__yes" aria-label="Included">✓</span>
                      ) : value === false ? (
                        <span class="compare__no" aria-label="Not included">—</span>
                      ) : (
                        value
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ---------- 7. CITED NUMBERS ---------- */}
  <section class="section section--tight" aria-labelledby="honest">
    <div class="wrap">
      <div class="section__head">
        <p class="micro micro--ember">No invented stats</p>
        <h2 id="honest">Every number here has a source.</h2>
        <p>Other quit apps ship "78% of members quit", cited to nobody. We don't.</p>
      </div>

      <ul class="stats">
        {
          stats.map((s, i) => (
            <li class="stat reveal" data-delay={i}>
              <p class="stat__figure">{s.figure}</p>
              <p class="stat__claim">{s.claim}</p>
              <p class="stat__source">{s.source}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- 8. FAQ ---------- */}
  <section class="section section--lift section--rules" aria-labelledby="faq">
    <div class="wrap">
      <div class="section__head">
        <p class="micro">Straight answers</p>
        <h2 id="faq">Quit vaping questions people actually ask</h2>
      </div>

      <div class="faq">
        {
          FAQS.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
              {/* Where a post owns the query, the snippet here hands off to it
                  rather than answering in full. See the note in content.ts. */}
              {'more' in item && <p class="faq__more"><a href={item.more.href}>{item.more.label}</a></p>}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 9. CLOSING ---------- */}
  <section class="section cta-band" id="get" aria-labelledby="get-h">
    <div class="wrap cta-band__grid">
      <div>
        <p class="micro micro--volt">Free to download</p>
        <h2 id="get-h">Your last puff is closer than you think.</h2>
        <p>Count your real number tonight. The plan starts from there, at a pace you pick.</p>
        <StoreBadges campaign="closing" />
      </div>

      {/* Desktop only (CSS): somebody reading on a computer still has to install
          on a phone. The code points at /download, which puts their store first. */}
      <div class="qr">
        <div class="qr__code" role="img" aria-label="QR code for cirrusquit.com/download" set:html={qr} />
        <div class="qr__text">
          <b>On a computer?</b>
          <span>Scan with your phone's camera to get the right version.</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
