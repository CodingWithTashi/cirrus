---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import AppDemo from '../components/AppDemo.astro';
import { HONEST_STATS, FAQS } from '../lib/content';

// Three of the five approved stats — the strongest, kept to Rangjong's
// three-card rhythm. All five remain in content.ts for the blog to use.
const stats = HONEST_STATS.filter((s) => ['76%', '28% → 53%', '15–20 min'].includes(s.figure));

const screens = [
  { src: '/screens/dependence.jpg', title: 'Your real number', caption: 'Not days clean. Puffs, going down.' },
  { src: '/screens/home.jpg', title: 'Today', caption: 'One tap to log. The rest does itself.' },
  { src: '/screens/pace.jpg', title: 'Your pace', caption: '14, 30 or 90 days. You pick.' },
];

---

<BaseLayout softwareApp faq={FAQS}>
  {/* ---------- 1. HERO ---------- */}
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="micro micro--volt">Quit vaping · coming soon</p>
        <h1>Quit vaping without going <span class="accent">cold turkey</span>.</h1>
        <p class="hero__sub">
          One bad Tuesday shouldn't cost you three weeks of progress.
        </p>
        <WaitlistForm source="hero" id="waitlist-hero" showCount />
      </div>

      <AppDemo part="phone" />
    </div>
  </section>

  {/* ---------- 2. THE LIVE WIDGET ---------- */}
  <section class="section section--lift section--rules" aria-labelledby="number">
    <div class="wrap">
      <div class="section__head">
        <p class="micro micro--volt">Live · no signup</p>
        <h2 id="number">So what does that number cost you?</h2>
        <p>Tap the keypad up there. Everything below moves with it.</p>
      </div>

      <AppDemo part="output" />
    </div>
  </section>

  {/* ---------- 3. PROOF ---------- */}
  <section class="section" aria-labelledby="inside">
    <div class="wrap">
      <div class="section__head">
        <p class="micro">Inside the app</p>
        <h2 id="inside">Built already. Not a landing page with a dream.</h2>
      </div>

      <div class="screens">
        {
          screens.map((s) => (
            <figure class="screen reveal">
              <div class="phone">
                <img src={s.src} width="720" height="1474" loading="lazy" decoding="async" alt={`Cirrus — ${s.title}`} />
              </div>
              <figcaption><b>{s.title}</b>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <div class="ember reveal">
        <div class="ember__avatar" aria-hidden="true">AI</div>
        <div>
          <p class="ember__name">Ember</p>
          <p class="ember__meta">● knows your plan · day 1</p>
          <blockquote class="ember__bubble">
            Hey. I'm Ember — I quit two years ago and I remember exactly how it felt. I've read
            your plan: 50 a day, Taper, Freedom Day Sep 27. No lectures from me, ever. What's
            going on right now?
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 4. NUMBERS INTERSTITIAL ---------- */}
  <section class="section section--tight section--lift section--rules" aria-labelledby="honest">
    <div class="wrap">
      <div class="section__head">
        <p class="micro micro--ember">No invented stats</p>
        <h2 id="honest">Every number here has a source.</h2>
        <p>Other quit apps ship "78% of members quit", cited to nobody. We don't.</p>
      </div>

      <ul class="stats">
        {
          stats.map((s, i) => (
            <li class="stat reveal" data-delay={i}>
              <p class="stat__figure">{s.figure}</p>
              <p class="stat__claim">{s.claim}</p>
              <p class="stat__source">{s.source}</p>
            </li>
          ))
        }
      </ul>

    </div>
  </section>

  {/* ---------- 5. FAQ ---------- */}
  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <div class="section__head">
        <p class="micro">Straight answers</p>
        <h2 id="faq">Questions people actually ask</h2>
      </div>

      <div class="faq">
        {
          FAQS.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- 6. CLOSING CTA ---------- */}
  <section class="section cta-band" id="join" aria-labelledby="join-h">
    <div class="wrap">
      <p class="micro micro--volt">Still here? Good sign.</p>
      <h2 id="join-h">Be there on day one.</h2>
      <p>One email when it's ready. Nothing else, ever.</p>
      <WaitlistForm source="footer" id="waitlist-footer" cta="Join the waitlist" label="Get early access" />
    </div>
  </section>
</BaseLayout>
