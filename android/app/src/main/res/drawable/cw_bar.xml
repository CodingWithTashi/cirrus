<?xml version="1.0" encoding="utf-8"?>
<!-- The wide layout's progress track. A ProgressBar is RemoteViews-legal; the
     ProgressRing the app draws with a CustomPainter is not. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/cw_volt_track"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/cw_volt"/>
                <corners android:radius="999dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
