<?xml version="1.0" encoding="utf-8"?>
<!--
  Cirrus home-screen widget, compact (2x2).

  Day number on top, count below — the reading order the founder asked for and
  the one the design frame uses.

  Two structural rules this file obeys, both of which are silent failures if
  broken:

  1. NO <View> and NO <Space>. Neither is on the AppWidget allowlist; either
     one throws at inflation and the launcher shows "Problem loading widget"
     with the reason only in logcat. Spacers are <ImageView> with a weight.
  2. Every id here also exists in cirrus_widget_wide.xml, byte for byte. The
     provider sets the same ids on both, and an id present in one and missing
     from the other makes half the setters no-op at whichever size the user
     happened to choose. test/android_widget_test.dart pins the two sets equal.

  The placeholder text matters: on API 31+ the widget picker inflates this
  layout directly (previewLayout) with no RemoteViews action applied, so the
  defaults below are what a user sees before they place it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cw_card"
    android:padding="@dimen/cw_pad">

    <LinearLayout
        android:id="@+id/cw_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1 · the day, on top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/cw_day"
                style="@style/CirrusWidget.Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cw_day_pill"
                android:maxLines="1"
                android:text="@string/cw_preview_day"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/cw_flame"
                style="@style/CirrusWidget.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="🔥"/>
        </LinearLayout>

        <!-- 2 · the count, below -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cw_count"
                style="@style/CirrusWidget.Count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp"
                android:maxLines="1"
                android:text="@string/cw_preview_count"/>
            <TextView
                android:id="@+id/cw_count_over"
                style="@style/CirrusWidget.CountOver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp"
                android:maxLines="1"
                android:visibility="gone"
                android:text="@string/cw_preview_count"/>
            <TextView
                android:id="@+id/cw_of"
                style="@style/CirrusWidget.OfLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="4dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:text="@string/cw_preview_of"/>
        </LinearLayout>

        <!-- 3 · where that leaves today -->
        <TextView
            android:id="@+id/cw_left"
            style="@style/CirrusWidget.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/cw_preview_left"/>

        <!-- Present but never shown at this size. It exists so both layouts
             carry the same id set and the provider needs no size branch for
             correctness — only for what it makes visible. -->
        <ProgressBar
            android:id="@+id/cw_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:progressDrawable="@drawable/cw_bar"
            android:max="100"
            android:progress="53"/>
        <ProgressBar
            android:id="@+id/cw_bar_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:progressDrawable="@drawable/cw_bar_over"
            android:max="100"
            android:progress="100"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp"
            android:importantForAccessibility="no"/>

        <!-- 4 · one puff in, one puff out -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/cw_minus"
                style="@style/CirrusWidget.Minus"
                android:layout_width="@dimen/cw_minus_w"
                android:layout_height="@dimen/cw_btn_h"
                android:background="@drawable/cw_btn_minus"
                android:text="@string/cw_minus_label"/>
            <TextView
                android:id="@+id/cw_plus"
                style="@style/CirrusWidget.Plus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/cw_btn_h"
                android:layout_marginStart="8dp"
                android:background="@drawable/cw_btn_plus"
                android:text="@string/cw_plus_label"/>
        </LinearLayout>
    </LinearLayout>

    <!-- No journey yet. The + and − are REMOVED, not disabled: there is
         nothing for a queued puff to apply to, and a control that appears to
         work and does nothing is the failure this codebase already named once
         (the buddy ping that pinged nobody). -->
    <LinearLayout
        android:id="@+id/cw_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/cw_empty_title"
            style="@style/CirrusWidget.Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/cw_empty_title"/>
        <TextView
            android:id="@+id/cw_empty_body"
            style="@style/CirrusWidget.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/cw_empty_body"/>
    </LinearLayout>
</FrameLayout>
