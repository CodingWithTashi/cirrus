---
// The home page in every live language but English, which keeps its own unprefixed
// route file beside this folder. The page itself is components/pages/HomePage.astro.
//
// Which languages exist is LIVE_LOCALES (i18n/locales.mjs) and nothing else: a
// dictionary can be written, type-checked and previewed for weeks without this
// route building a single page for it.
//
// `build.format: 'file'` writes this as dist/es.html, so the URL is /es — never
// /es/, which Cloudflare Pages 308s to it, exactly as it does for /blog/.
import HomePage from '../../components/pages/HomePage.astro';
import { DEFAULT_LOCALE, LIVE_LOCALES } from '../../i18n/locales.mjs';
import type { Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LIVE_LOCALES.filter((lang) => lang !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<HomePage lang={lang} />
