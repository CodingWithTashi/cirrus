---
// "What is it costing you?" — the app's own onboarding step, on the web.
//
// docs/06 §5 wants this as a link magnet and the TikTok bio destination, and it
// is the only honest way to put a money figure on a marketing page: the visitor
// supplies the input, so the output is arithmetic rather than a claim. Hence the
// label lifted straight from the app: "your math, not ours".
//
// No framework, no storage, no analytics — it is one input and three sums.
---

<div class="calc" data-calc>
  <div class="calc-input-row">
    <label class="calc-label" for="calc-weekly">What do you spend a week?</label>
    <div class="calc-field">
      <span class="calc-currency" aria-hidden="true">$</span>
      <input
        id="calc-weekly"
        type="number"
        inputmode="decimal"
        min="0"
        max="1000"
        step="1"
        value="20"
        data-calc-input
        aria-describedby="calc-out"
      />
      <span class="calc-suffix">/ week</span>
    </div>
  </div>

  <div class="calc-out" id="calc-out" role="status" aria-live="polite">
    <p class="calc-lead">that's</p>
    <p class="calc-big"><span data-calc-year>$1,040</span> a year</p>
    <ul class="calc-chips">
      <li><span data-calc-month>$87</span> / month</li>
      <li><span data-calc-day>$2.86</span> / day</li>
      <li class="calc-chip-note">your math, not ours</li>
    </ul>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-calc-input]')!;
    const year = root.querySelector<HTMLElement>('[data-calc-year]')!;
    const month = root.querySelector<HTMLElement>('[data-calc-month]')!;
    const day = root.querySelector<HTMLElement>('[data-calc-day]')!;

    // Whole dollars for the big number, cents for the per-day figure — a yearly
    // total to the penny reads like false precision on an estimate.
    const whole = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    });
    const cents = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });

    const render = () => {
      const weekly = Math.min(Math.max(Number(input.value) || 0, 0), 1000);
      year.textContent = whole.format(weekly * 52);
      month.textContent = whole.format((weekly * 52) / 12);
      day.textContent = cents.format(weekly / 7);
    };

    input.addEventListener('input', render);
    render();
  }
</script>
