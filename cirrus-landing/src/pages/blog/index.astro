---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Notes on quitting vaping — what the research says, what actually works, and how Cirrus is built."
>
  <h1>Blog</h1>
  <p class="lede">
    Notes on quitting vaping — what the research says, what actually works, and how Cirrus is built.
  </p>

  {
    posts.length === 0 ? (
      <p class="post-meta" style="margin-top:2rem">
        No posts yet. Add a Markdown file to <code>src/content/blog/</code> to publish one.
      </p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <p class="post-meta">
              <time datetime={post.data.publishedAt.toISOString()}>
                {formatDate(post.data.publishedAt)}
              </time>
            </p>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
