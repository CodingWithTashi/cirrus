# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase service-account keys. Deployed functions use Application Default
# Credentials, so no key is ever needed in git; the glob survives a rotation.
**/*-adminsdk-*.json

# App Check debug secret (see lib/data/api/firebase/app_check_setup.dart).
# A registered debug token bypasses attestation for the whole project, so it
# is a credential: local only, never committed.
.appcheck_token

# Firebase CLI deploy cache — local build state, not source.
.firebase/
.appcheck_token.registered*
.dart_defines.json

# Claude Code per-machine permissions and hooks (local paths, local tooling).
**/.claude/settings.local.json
